AISCIENTIST_APP_NAME=FSAD Scientist
AISCIENTIST_ENVIRONMENT=development
AISCIENTIST_RUNTIME=mock
AISCIENTIST_STORAGE_ROOT=storage/projects
AISCIENTIST_ARTIFACT_ROOT=artifacts
AISCIENTIST_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AISCIENTIST_LIVE_EVIDENCE=true
AISCIENTIST_EVIDENCE_MAILTO=
AISCIENTIST_DINOV2_PROFILE_MODEL=facebook/dinov2-small

# Alibaba Cloud Model Studio / DashScope
DASHSCOPE_API_KEY=
AISCIENTIST_BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AISCIENTIST_REASONING_MODEL=qwen3.7-plus
AISCIENTIST_VISION_MODEL=qwen3-vl-plus
AISCIENTIST_EMBEDDING_MODEL=text-embedding-v4
AISCIENTIST_RERANK_MODEL=qwen3-rerank

# Later-stage infrastructure
AISCIENTIST_DATABASE_URL=postgresql+psycopg://fsad:fsad@localhost:5432/fsad_scientist
AISCIENTIST_REDIS_URL=redis://localhost:6379/0
AISCIENTIST_MLFLOW_TRACKING_URI=http://localhost:5000
AISCIENTIST_MINIO_ENDPOINT=http://localhost:9000
