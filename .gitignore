# Secrets and local configuration
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Runtime data, models and outputs
data/**
!data/.gitkeep
artifacts/**
!artifacts/.gitkeep
storage/**
!storage/.gitkeep
logs/**
!logs/.gitkeep
tmp/
*.pt
*.pth
*.ckpt
*.onnx

# Downloaded third-party source; keep provenance only
third_party/**
!third_party/README.md
!third_party/manifest.lock.json

# Reference PDFs are tracked by digest, not committed as binaries
docs/references/papers/*.pdf

# Editors and OS
.idea/
.vscode/
.DS_Store
Thumbs.db
